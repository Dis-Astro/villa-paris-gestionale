DATABASE_URL="postgresql://villaparis:villaparis_secret@localhost:5432/villaparis?schema=public"
JWT_SECRET="sostituisci_con_una_stringa_lunga_e_casuale"
JWT_EXPIRES_HOURS="8"
COOKIE_SECURE="false"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Opzionali: servono solo se colleghi Google Calendar.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Token lungo e casuale usato dal cron per importare automaticamente Google Calendar.
# Chiamata: GET /api/google-calendar/import con header Authorization: Bearer <token>
CALENDAR_SYNC_SECRET=""
CALENDAR_SYNC_INTERVAL_SECONDS="300"

# Analisi e correzione AI server-side (la chiave non viene mai inviata al browser).
AI_ENABLED="false"
AI_PROVIDER="openai"
AI_API_KEY=""
AI_BASE_URL="https://api.openai.com/v1"
AI_MODEL="gpt-5.6-terra"
AI_AUTO_APPLY="false"
AI_MIN_CONFIDENCE="0.90"
AI_INCLUDE_PERSONAL_DATA="false"
AI_BATCH_SIZE="10"
AI_TIMEOUT_MS="60000"
AI_TOOL_SECRET=""
AI_TOOLS_WRITE_ENABLED="false"
